# Copy to .env and fill in local values. Never commit .env.
MSSQL_SA_PASSWORD=replace-with-a-strong-password
SQLSERVER_PORT=14333
DB_NAME=RTS_DB
HQ_URL=http://localhost:9000/api/v1
SYNC_INTERVAL=3600
SYNC_RETRY_BASE_SECONDS=60
JWT_SECRET=replace-with-a-long-random-secret
DB_HOST=127.0.0.1
TEST_DB_NAME=RTS_DB_TEST
MTLS_REQUIRED=false
POS_GATEWAY_SECRET=replace-with-a-long-random-secret
# Longest wait for each single database lock on the POS path, in ms (positive).
POS_LOCK_TIMEOUT_MS=2000
# PB-18 HQ demo service. The middleware uses these when it sends a batch.
HQ_DB_NAME=RTS_HQ
HQ_CA_FILE=.certs/ca.crt
HQ_TIMEOUT_SECONDS=3
SCHEDULER_ENABLED=false
HQ_JWT_SECRET=replace-with-a-long-random-secret
# PB-21: alert window for a product category without a near_expiry_config row (0-3650).
NEAR_EXPIRY_DEFAULT_DAYS=3
# PB-49: the Dashboard's two time-quality thresholds. A POS-declared occurred_at
# within MAX_FUTURE_SKEW of the receipt time is ON_TIME; earlier than that but no
# more than MAX_BACKFILL_DAYS behind is a trusted BACKFILL; anything else is one of
# the two SUSPECT groups.
POS_MAX_FUTURE_SKEW_SECONDS=300
POS_MAX_BACKFILL_DAYS=30
# Private demo interface; set both to machine S's private IP for the LAN demo.
POS_BIND_ADDRESS=127.0.0.1
MIDDLEWARE_BIND_ADDRESS=127.0.0.1
